{
  "dashboard": {
    "id": null,
    "title": "Spring Boot Load Test Dashboard",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "timeseries",
        "title": "RPS",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Error Rate (5xx)",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Average Latency (ms)",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_sum[1m])) / sum(rate(http_server_requests_seconds_count[1m])) * 1000",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "P95 Latency (ms)",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}